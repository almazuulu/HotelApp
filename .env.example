# HotelApp — local environment template.
#
#   cp .env.example .env
#
# .env is git-ignored and must never be committed. Every value below is a safe
# local placeholder: change the passwords and the secret key on your machine.
# This environment is local-only — there is no production configuration.

# --- PostgreSQL ---
POSTGRES_DB=hotelapp
POSTGRES_USER=hotelapp
POSTGRES_PASSWORD=change-me-locally
# POSTGRES_HOST and POSTGRES_PORT are set by docker-compose.yml for the backend
# container. Set them here only when running Django outside Docker.

# --- Django ---
DJANGO_SECRET_KEY=change-me-insecure-local-development-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# The browser talks to the Vite dev server, so that origin must be trusted for CSRF.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DJANGO_LANGUAGE_CODE=ru-ru
# Business timezone for booking deadlines. Do not change without a product decision.
DJANGO_TIME_ZONE=Asia/Bishkek

# --- Host ports ---
# Change these if a port is already taken on your machine.
POSTGRES_HOST_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Demo accounts ---
# Read by the seed_demo management command, which is not implemented yet.
# These are throwaway local credentials, never real ones.
DEMO_MANAGER_USERNAME=manager
DEMO_MANAGER_EMAIL=manager@example.com
DEMO_MANAGER_PASSWORD=change-me-locally
DEMO_EDITOR_USERNAME=editor
DEMO_EDITOR_EMAIL=editor@example.com
DEMO_EDITOR_PASSWORD=change-me-locally
DEMO_CUSTOMER_USERNAME=customer
DEMO_CUSTOMER_EMAIL=customer@example.com
DEMO_CUSTOMER_PASSWORD=change-me-locally
